{
  "expo": {
    "name": "plastiCorp",
    "slug": "plastiCorp",
    "scheme": "plastiCorp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconCentral.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cesar-colmenarez.plastiCorp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cesar_colmenarez.plastiCorp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47bd7262-d5d1-4049-a777-5c51ab1b4d9c"
      }
    }
  }
}
